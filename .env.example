# --- LLM provider -----------------------------------------------------------
# Setting OPENROUTER_API_KEY selects OpenRouter for both the agent and Cognee.
# Leave it empty to fall back to OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Used when OPENROUTER_API_KEY is not set. Also used for OpenAI embeddings,
# which OpenRouter does not provide (see below).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Embeddings -------------------------------------------------------------
# Cognee configures embeddings separately from the LLM, and OpenRouter has no
# embeddings endpoint. Default is OpenAI (needs OPENAI_API_KEY with quota).
# To embed locally instead, install `pip install -e ".[local-embeddings]"` and
# uncomment the three lines below.
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# Upper bound on a single Cognee add/cognify call, in seconds. Prevents a
# stalled Cognee call from holding an HTTP request open forever.
COGNEE_TIMEOUT_SECONDS=900

# --- Other ------------------------------------------------------------------
# Optional: raises GitHub API rate limits / enables private repos
GITHUB_TOKEN=

# Local embedded storage root (Cognee data + workspace registry)
EDI_DATA_DIR=.decision_intelligence
